---
import BaseLayout from './BaseLayout.astro';
import { categoryLabel, type CategoryId } from '../data/categories';

interface Props {
  data: {
    title: string;
    summary: string;
    abstract: string;
    categories: CategoryId[];
    tags?: string[];
    role: string;
    dates: string;
    award?: string;
    thumbnail?: string;
    stack?: string[];
    results?: string[];
    learned?: string[];
    links?: { label: string; url: string; type: string }[];
  };
}
const { data } = Astro.props;
const links = (data.links ?? []).filter((l) => l.url && l.url !== '#');
const stack = data.stack ?? [];
const results = data.results ?? [];
const learned = data.learned ?? [];
---

<BaseLayout title={data.title} description={data.summary} type="article" image={data.thumbnail}>
  <article class="container-x pt-10">
    <a href="/projects" class="group text-[0.92rem] text-muted transition-colors hover:text-ink">
      <span class="inline-block transition-transform group-hover:-translate-x-0.5">←</span> Projects
    </a>

    <header class="reveal mt-10 max-w-3xl">
      <p class="eyebrow">{data.categories.map((c) => categoryLabel(c)).join(' · ')}</p>
      <h1 class="mt-3 text-4xl font-semibold leading-[1.08] text-ink sm:text-5xl">{data.title}</h1>
      {data.award && <p class="mt-4 text-[1.02rem] text-accent-400">{data.award}</p>}
      <p class="mt-6 text-lg leading-relaxed text-ink-soft">{data.abstract}</p>

      <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-line pt-6 text-[0.95rem] sm:grid-cols-3">
        <div>
          <dt class="text-faint">Role</dt>
          <dd class="mt-1 text-ink-soft">{data.role}</dd>
        </div>
        <div>
          <dt class="text-faint">Timeline</dt>
          <dd class="mt-1 text-ink-soft">{data.dates}</dd>
        </div>
        {
          stack.length > 0 && (
            <div class="col-span-2 sm:col-span-1">
              <dt class="text-faint">Built with</dt>
              <dd class="mt-1 text-ink-soft">{stack.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      {
        links.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {links.map((link, i) => {
              const external = link.url.startsWith('http');
              return (
                <a
                  href={link.url}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class={i === 0 ? 'btn-primary' : 'btn-secondary'}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        )
      }
    </header>

    {
      data.thumbnail && (
        <figure class="reveal mt-14 overflow-hidden rounded-xl border border-line">
          <img src={data.thumbnail} alt={`Illustration for ${data.title}`} class="aspect-[16/9] w-full object-cover" loading="lazy" decoding="async" />
        </figure>
      )
    }

    <div class="mt-16 max-w-3xl">
      {
        results.length > 0 && (
          <section class="mb-14">
            <h2 class="text-2xl font-semibold text-ink">Key results</h2>
            <ul class="mt-5 space-y-3 text-[1.0625rem] leading-relaxed text-ink-soft">
              {results.map((r) => (
                <li class="border-l-2 border-accent-500/60 pl-4">{r}</li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="prose-site">
        <slot />
      </div>

      {
        learned.length > 0 && (
          <section class="mt-14 border-t border-line pt-10">
            <h2 class="text-2xl font-semibold text-ink">What I learned</h2>
            <ul class="mt-5 list-disc space-y-2.5 pl-5 text-[1.0625rem] leading-relaxed text-ink-soft marker:text-faint">
              {learned.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
