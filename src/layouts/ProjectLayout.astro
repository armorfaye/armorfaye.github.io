---
import BaseLayout from './BaseLayout.astro';

interface Props {
  // True when the page passes a figure (e.g. an animated diagram) in the "figure" slot.
  hasFigure?: boolean;
  data: {
    title: string;
    summary: string;
    abstract: string;
    role: string;
    dates: string;
    award?: string;
    thumbnail?: string;
    stack?: string[];
    results?: string[];
    learned?: string[];
    links?: { label: string; url: string; type: string }[];
  };
}
const { data, hasFigure = false } = Astro.props;
const links = (data.links ?? []).filter((l) => l.url && l.url !== '#');
const stack = data.stack ?? [];
const results = data.results ?? [];
const learned = data.learned ?? [];
const [name, subtitle] = data.title.split(/:\s*/, 2);
let n = 0;
const next = () => String(++n).padStart(2, '0');
---

<BaseLayout title={data.title} description={data.summary} type="article" image={data.thumbnail}>
  <p class="mono mt-6"><a href="/projects" class="tlink">← Projects</a></p>
  <h1 class="page-title proj-title" data-scramble-load>{name}</h1>

  <div class="page-intro">
    <dl class="meta mono">
      {data.award && <><dt>Award</dt><dd class="accent">{data.award}</dd></>}
      <dt>Role</dt>
      <dd>{data.role}</dd>
      <dt>When</dt>
      <dd>{data.dates}</dd>
      {stack.length > 0 && <><dt>Stack</dt><dd>{stack.join(', ')}</dd></>}
      {
        links.length > 0 && (
          <>
            <dt>Links</dt>
            <dd class="flex flex-col">
              {links.map((l) => (
                <a href={l.url} class="tag-link" {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  {l.label}
                </a>
              ))}
            </dd>
          </>
        )
      }
    </dl>
    <div class="intro-text">
      {subtitle && <p class="subtitle rv">{subtitle}</p>}
      <p class="abstract rv" style="--d: 80ms">{data.abstract}</p>
    </div>
  </div>

  {
    hasFigure && (
      <section class="sec">
        <h2 class="sec-label mono"><span class="idx">{next()}</span><span>Figure</span></h2>
        <div class="sec-body rv">
          <slot name="figure" />
        </div>
      </section>
    )
  }

  {
    results.length > 0 && (
      <section class="sec">
        <h2 class="sec-label mono"><span class="idx">{next()}</span><span data-scramble>Results</span></h2>
        <div class="sec-body">
          <ul class="results">
            {results.map((r, i) => (
              <li class="rv">
                <span class="mono dim">{String(i + 1).padStart(2, '0')}</span>
                <span>{r}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="sec">
    <h2 class="sec-label mono"><span class="idx">{next()}</span><span data-scramble>Write-up</span></h2>
    <div class="sec-body prose-site">
      <slot />
    </div>
  </section>

  {
    learned.length > 0 && (
      <section class="sec">
        <h2 class="sec-label mono"><span class="idx">{next()}</span><span data-scramble>Learned</span></h2>
        <div class="sec-body">
          <ul class="results">
            {learned.map((l, i) => (
              <li class="rv">
                <span class="mono dim">{String(i + 1).padStart(2, '0')}</span>
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .proj-title {
    font-size: clamp(52px, 9vw, 136px);
  }
  .meta {
    grid-column: 1 / 4;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 8px 12px;
    align-content: start;
    text-transform: none;
  }
  .meta dt {
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .meta dd {
    margin: 0;
    color: var(--color-ink);
  }
  .intro-text {
    grid-column: 4 / 12;
  }
  .subtitle {
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-ink);
    margin-bottom: 18px;
  }
  .abstract {
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 62ch;
  }
  .results {
    max-width: 72ch;
  }
  .results li:first-child {
    padding-top: 0;
  }
  .results li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .results .mono {
    padding-top: 4px;
  }
  @media (max-width: 760px) {
    .meta,
    .intro-text {
      grid-column: 1 / 13;
    }
    .intro-text {
      order: -1;
    }
  }
</style>
