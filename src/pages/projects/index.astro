---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const year = (d: string) => d.match(/\d{4}(?!.*\d{4})/)?.[0] ?? d;
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Projects"
  description="Projects by Jiayu (Jerry) Liu: Senju (agent swarm, hackathon winner), TriFallNet, AudioAware, topological data analysis, and hyperplane arrangements."
>
  <h1 class="page-title" data-scramble-load>Projects</h1>
  <div class="page-intro">
    <p class="mono dim rv">{projects.length} projects</p>
    <p class="lead rv" style="--d: 80ms">
      Agent systems, machine-learning research, assistive hardware, and mathematics.
    </p>
  </div>

  <section class="sec">
    <h2 class="sec-label mono"><span class="idx">01</span><span data-scramble>Index</span></h2>
    <div class="sec-body">
      <ul class="rows-big">
        {
          projects.map((p, i) => (
            <li class="rv">
              <a href={`/projects/${p.id}`} class="row-big" data-img={p.data.thumbnail}>
                <span class="mono dim">{pad(i + 1)}</span>
                <span class="main">
                  <span class="title">{p.data.title.split(':')[0]}</span>
                  <span class="tag">
                    {p.data.award && <span class="mono accent mr-2">Winner</span>}
                    {p.data.tagline}
                  </span>
                </span>
                <span class="mono dim">{year(p.data.dates)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
