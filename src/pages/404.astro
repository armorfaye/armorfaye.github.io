---
import BaseLayout from '../layouts/BaseLayout.astro';
import LossLandscape from '../components/LossLandscape.astro';
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist.">
  <h1 class="page-title" data-scramble-load>404</h1>
  <div class="page-intro" data-fig-root>
    <p class="mono dim">Not found</p>
    <div class="lead">
      <p>This page doesn’t exist. Like the optimizer below, try another starting point:{' '}
        <a href="/" class="ul">home</a> or <a href="/research" class="ul">research</a>.</p>
      <div class="mt-8 h-[300px] text-[#4a4c47]"><LossLandscape cell={10} /></div>
      <p class="mono-lc dim mt-2"><button type="button" class="fig-opt" data-fig-opt title="Switch optimizer">sgd + momentum</button> · <span data-fig-caption></span></p>
    </div>
  </div>
</BaseLayout>
