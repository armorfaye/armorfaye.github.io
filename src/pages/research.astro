---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { publications, posters, areaLabel } from '../data/publications';
import { experienceSections } from '../data/experience';

// Current research positions (education is not research).
const current = experienceSections
  .filter((s) => s.id !== 'education')
  .flatMap((s) => s.entries)
  .filter((e) => e.current);

const sorted = [...publications].sort((a, b) => b.year - a.year);

const filters = [
  { id: 'all', label: 'All' },
  ...(['math', 'ml'] as const).map((a) => ({ id: a, label: areaLabel[a] })),
];
---

<BaseLayout
  title="Research"
  description="Publications and ongoing research of Jiayu (Jerry) Liu: configuration spaces with Charles Fefferman, hyperplane arrangements, fall detection, topological data analysis, and LLM research at Stanford."
>
  <h1 class="page-title" data-scramble-load>Research</h1>
  <div class="page-intro">
    <p class="mono dim rv">{publications.length} papers · {posters.length} posters</p>
    <p class="lead rv" style="--d: 80ms">
      I work across pure mathematics (topology, analysis, Coxeter groups) and machine learning
      (LLMs, pose, multimodal models, topological ML).
    </p>
  </div>

  <section class="sec">
    <h2 class="sec-label mono"><span class="idx">01</span><span data-scramble>Ongoing</span></h2>
    <div class="sec-body">
      <ul class="table">
        {current.map((e) => <ExperienceItem entry={e} />)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <h2 class="sec-label mono"><span class="idx">02</span><span data-scramble>Publications</span></h2>
    <div class="sec-body">
      <div class="mono mb-6 flex gap-5" role="group" aria-label="Filter by area">
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="pub-filter cursor-pointer uppercase text-muted transition-colors hover:text-ink aria-pressed:text-accent-600"
            >
              [{f.label}]
            </button>
          ))
        }
      </div>
      <ul class="pubs">
        {sorted.map((pub) => <PublicationItem pub={pub} />)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <h2 class="sec-label mono"><span class="idx">03</span><span data-scramble>Posters</span></h2>
    <div class="sec-body">
      <ul class="table">
        {
          posters.map((p) => (
            <li class="rv">
              <span class="mono dim">{p.venue}</span>
              <a href={p.url} class="t-main tlink col-span-2">
                {p.title} <span class="arr">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
    const pubs = document.querySelectorAll<HTMLElement>('.pub');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        pubs.forEach((p) => p.classList.toggle('hidden', f !== 'all' && p.dataset.area !== f));
      }),
    );
  </script>
</BaseLayout>

<style>
  .pubs :global(.pub:first-child) {
    padding-top: 0;
  }
</style>
