---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { experienceSections, awards } from '../data/experience';
import { site } from '../data/site';

const sections = experienceSections.filter((s) => s.entries.length > 0);
---

<BaseLayout title="Experience" description="Research, industry, education, and honors of Jiayu (Jerry) Liu.">
  <div class="container-x pt-14">
    <SectionHeader as="h1" title="Experience" subtitle="Research, industry, and education, newest first." link={{ label: 'Resume (PDF)', href: site.resume }} />

    <div class="space-y-20">
      {
        sections.map((section) => (
          <section>
            <h2 class="reveal mb-4 text-xl font-semibold text-ink">{section.title}</h2>
            <ul class="border-b border-line">
              {section.entries.map((entry, i) => (
                <ExperienceItem entry={entry} delay={i * 40} />
              ))}
            </ul>
          </section>
        ))
      }

      <section>
        <h2 class="reveal mb-4 text-xl font-semibold text-ink">Honors</h2>
        <ul class="reveal border-b border-line">
          {
            awards.map((a) => (
              <li class="grid gap-1 border-t border-line py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
                <p class="text-sm tabular-nums text-faint">{a.year ?? ''}</p>
                <p class="text-[1.02rem] text-ink">
                  {a.link ? <a href={a.link} class="font-semibold transition-colors hover:text-accent-300">{a.title}</a> : <span class="font-semibold">{a.title}</span>}
                  <span class="text-muted"> · {a.detail}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
