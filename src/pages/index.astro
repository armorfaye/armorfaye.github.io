---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SenjuShowcase from '../components/SenjuShowcase.astro';
import { experienceHighlights, awards } from '../data/experience';
import { publications } from '../data/publications';

const all = await getCollection('projects');
const projects = all.filter((p) => p.data.featured && p.id !== 'senju').sort((a, b) => a.data.order - b.data.order);
const senju = all.find((p) => p.id === 'senju')!;

const now = [
  {
    where: 'Stanford NLP, Percy Liang’s group',
    title: 'Priced-guidance RL',
    body: 'Building a guidance-based pipeline for data creation and RL environment generation, and contributing to the next Marin pretraining architecture (~600B).',
    href: 'https://marin.community',
    cta: 'marin.community',
  },
  {
    where: 'Hazy Research, with Hermann Kumbong',
    title: 'Speculative decoding for NCM',
    body: 'Speeding up Next-Concept Modeling, which generates text coarse-to-fine, level by level in parallel, instead of one token at a time.',
    href: 'https://hazyresearch.stanford.edu/blog/2026-10-12-ncm',
    cta: 'About NCM',
  },
  {
    where: 'Hackathon winner',
    title: 'Senju 千手',
    body: 'A swarm of computer-use agents with their own cursors, working in your real apps while you keep working.',
    href: '/projects/senju',
    cta: 'Project page',
  },
];
---

<BaseLayout>
  <Hero />

  <!-- Now -->
  <section class="container-x pt-16">
    <SectionHeader eyebrow="Now" title="What I’m working on" />
    <div class="grid gap-x-10 gap-y-10 md:grid-cols-3">
      {
        now.map((n, i) => {
          const external = n.href.startsWith('http');
          return (
            <div class="reveal border-t border-line-strong pt-5" style={`--delay: ${i * 80}ms`}>
              <p class="text-sm text-faint">{n.where}</p>
              <h3 class="mt-2 text-lg font-semibold text-ink">{n.title}</h3>
              <p class="mt-2 text-[0.97rem] leading-relaxed text-muted">{n.body}</p>
              <a
                href={n.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="mt-4 inline-block text-sm text-accent-400 transition-colors hover:text-accent-300"
              >
                {n.cta} {external ? '↗' : '→'}
              </a>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Senju -->
  <section class="container-x pt-32">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-14">
      <div class="reveal min-w-0">
        <p class="eyebrow">Featured project · Hackathon winner</p>
        <h2 class="mt-2 text-3xl font-semibold text-ink sm:text-4xl">Senju 千手</h2>
        <p class="mt-1 text-lg text-muted">A thousand hands on your desktop</p>
        <p class="mt-6 text-[1.05rem] leading-relaxed text-ink-soft">
          Type one goal and a lead agent splits it across a swarm of Claude agents. Each one gets its
          own cursor and works in your real browser and Mac apps, while your mouse and keyboard stay
          yours. You can step in on any agent mid-task, and nothing is sent in your name without your
          approval. When a job finishes, the lead saves what it learned as a skill for next time.
        </p>
        <p class="mt-4 text-[0.97rem] text-muted">
          Won the Ricursive Intelligence Hackathon.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/projects/senju" class="btn-primary">How it works</a>
          {
            senju.data.links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
      <div class="reveal min-w-0" style="--delay: 120ms">
        <SenjuShowcase />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="container-x pt-32">
    <SectionHeader eyebrow="Projects" title="Selected work" link={{ label: 'All projects', href: '/projects' }} />
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
      {
        projects.map((p, i) => (
          <div class="reveal" style={`--delay: ${(i % 2) * 80}ms`}>
            <ProjectCard
              slug={p.id}
              title={p.data.title}
              summary={p.data.summary}
              dates={p.data.dates}
              thumbnail={p.data.thumbnail}
              award={p.data.award}
            />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Publications -->
  <section class="container-x pt-32">
    <SectionHeader eyebrow="Publications" title="Papers" link={{ label: 'All research', href: '/research' }} />
    <div class="reveal border-b border-line">
      {publications.map((pub) => <PublicationItem pub={pub} compact />)}
    </div>
  </section>

  <!-- Experience -->
  <section class="container-x pt-32">
    <SectionHeader eyebrow="Experience" title="Where I’ve worked" link={{ label: 'Full experience', href: '/experience' }} />
    <ul class="border-b border-line">
      {experienceHighlights.map((entry, i) => <ExperienceItem entry={entry} delay={i * 50} showBullets={false} />)}
    </ul>
  </section>

  <!-- Honors -->
  <section class="container-x pt-24">
    <SectionHeader eyebrow="Honors" title="Recognition" />
    <ul class="reveal border-b border-line">
      {
        awards.map((a) => (
          <li class="grid gap-1 border-t border-line py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <p class="text-sm tabular-nums text-faint">{a.year ?? ''}</p>
            <p class="text-[1.02rem] text-ink">
              {a.link ? <a href={a.link} class="font-semibold transition-colors hover:text-accent-300">{a.title}</a> : <span class="font-semibold">{a.title}</span>}
              <span class="text-muted"> · {a.detail}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
