---
import { site, socialLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="contact" class="mt-4 border-t border-line pb-8 pt-7">
  <div class="grid grid-cols-12 gap-6">
    <p class="mono dim col-span-12 md:col-span-3">Say hello</p>
    <div class="col-span-12 md:col-span-9">
      <a href={`mailto:${site.email}`} class="mail">{site.email} <span class="arr">↗</span></a>
      <p class="mt-2 max-w-[44ch] text-[16px] text-muted">
        Happy to talk about LLMs, agents, topology, or a problem you’re stuck on.
      </p>
    </div>
  </div>
  <div class="mono mt-16 flex flex-wrap justify-between gap-3">
    <span class="dim">© {year} {site.name}</span>
    <span class="flex gap-[22px]">
      {
        socialLinks
          .filter((l) => l.name !== 'mail')
          .map((l) => (
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="tlink" data-scramble>
              {l.label}
            </a>
          ))
      }
      <a href={site.resume} class="tlink" data-scramble>CV</a>
    </span>
  </div>
</footer>

<style>
  .mail {
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--color-ink);
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0% 2px no-repeat;
    padding-bottom: 4px;
    transition:
      background-size 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      color 0.2s;
    overflow-wrap: anywhere;
  }
  .mail:hover {
    background-size: 100% 2px;
  }
</style>
