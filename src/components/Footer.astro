---
import { site, socialLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="contact" class="mt-32 border-t border-line">
  <div class="container-x py-16">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-ink sm:text-3xl">Get in touch</h2>
        <p class="mt-3 max-w-md text-muted">
          Happy to talk about LLMs, agents, topology, or a problem you’re stuck on.
        </p>
        <a href={`mailto:${site.email}`} class="link mt-5 inline-block text-lg">{site.email}</a>
      </div>

      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem]">
        {
          socialLinks
            .filter((l) => l.name !== 'mail')
            .map((l) => (
              <li>
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted transition-colors hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))
        }
        <li>
          <a href={site.resume} class="text-muted transition-colors hover:text-ink">Resume</a>
        </li>
      </ul>
    </div>

    <p class="mt-14 text-sm text-faint">© {year} {site.name}</p>
  </div>
</footer>
