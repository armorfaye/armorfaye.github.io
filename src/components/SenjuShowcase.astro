---
// Animated illustration of Senju: a lead agent dispatching worker agents,
// each with its own ghost cursor, across real app windows on one desktop.
// Pure CSS/SVG motion; the log lines rotate with a tiny script.
const workers = [
  { id: 'w1', label: 'worker·1', cls: 'c1' },
  { id: 'w2', label: 'worker·2', cls: 'c2' },
  { id: 'w3', label: 'worker·3', cls: 'c3' },
];
const log = [
  ['lead', 'split goal → 3 tasks, spawning workers'],
  ['w1', 'browser › searching flights SFO → JFK'],
  ['w2', 'sheets › filling row 14 with quotes'],
  ['w3', 'mail › drafting summary for the team'],
  ['lead', 'w1 found cheaper fare → replanning'],
  ['w3', 'awaiting approval: send as you?'],
  ['you', 'approved ✓'],
  ['lead', 'job done · writing retrospective → skill.md'],
];
---

<div class="senju-demo relative" aria-label="Animated illustration of Senju running three agents on one desktop" role="img">
  <div
    class="relative overflow-hidden rounded-2xl border border-line-strong bg-void shadow-[0_30px_80px_-40px_rgb(37_196_112/0.35)]"
  >
    <!-- Desktop wallpaper -->
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_0%,rgb(31_214_114/0.18),transparent_60%),radial-gradient(ellipse_at_100%_100%,rgb(31_214_114/0.08),transparent_50%)]"
    >
    </div>

    <!-- Prompt bar -->
    <div class="relative z-10 mx-auto mt-4 flex w-[88%] items-center gap-2 rounded-xl border border-accent-500/40 bg-surface/90 px-3 py-2  backdrop-blur">
      <span class="shrink-0 whitespace-nowrap font-display text-sm font-bold text-accent-300">千手</span>
      <span class="h-4 w-px bg-line-strong"></span>
      <span class="truncate font-mono text-[0.68rem] text-ink-soft sm:text-xs">
        plan my NYC trip, log quotes in the sheet, and email the team
      </span>
      <span class="ml-auto hidden shrink-0 whitespace-nowrap rounded border border-line-strong px-1.5 py-0.5 font-mono text-[0.6rem] text-faint sm:inline">⌘⇧␣</span>
    </div>

    <!-- Stage -->
    <div class="relative z-0 mx-auto aspect-[16/10] w-full">
      <!-- Connection lines from the lead -->
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 160 100" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="senju-line" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#3ef08a" stop-opacity="0.9"></stop>
            <stop offset="1" stop-color="#3ef08a" stop-opacity="0.1"></stop>
          </linearGradient>
        </defs>
        <path d="M80 12 C 60 20, 35 22, 28 34" class="flow" stroke="url(#senju-line)"></path>
        <path d="M80 12 C 100 22, 120 24, 128 32" class="flow" stroke="url(#senju-line)"></path>
        <path d="M80 12 C 82 40, 78 52, 80 62" class="flow" stroke="url(#senju-line)"></path>
      </svg>

      <!-- Lead node -->
      <div class="absolute left-1/2 top-[6%] z-20 -translate-x-1/2">
        <div class="flex items-center gap-1.5 rounded-full border border-accent-400/60 bg-accent-400/15 px-2.5 py-1 font-mono text-[0.6rem] text-accent-200  backdrop-blur">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-400"></span> lead
        </div>
      </div>

      <!-- Window: browser -->
      <div class="win left-[4%] top-[26%] w-[40%]">
        <div class="win-bar"><i></i><i></i><i></i><span>flights</span></div>
        <div class="space-y-1.5 p-2">
          <div class="h-2 w-3/4 rounded bg-line-strong"></div>
          <div class="flex gap-1.5">
            <div class="h-6 flex-1 rounded border border-line bg-raised"></div>
            <div class="h-6 flex-1 rounded border border-accent-500/50 bg-accent-500/10 hl"></div>
          </div>
          <div class="h-2 w-1/2 rounded bg-line"></div>
          <div class="h-2 w-2/3 rounded bg-line"></div>
        </div>
      </div>

      <!-- Window: sheet -->
      <div class="win right-[4%] top-[24%] w-[40%]">
        <div class="win-bar"><i></i><i></i><i></i><span>quotes.xlsx</span></div>
        <div class="grid grid-cols-4 gap-px bg-line p-px">
          {
            Array.from({ length: 16 }).map((_, i) => (
              <div class:list={['h-3 bg-raised', i === 9 && 'cell-fill']} />
            ))
          }
        </div>
      </div>

      <!-- Window: mail -->
      <div class="win left-[30%] top-[58%] w-[40%]">
        <div class="win-bar"><i></i><i></i><i></i><span>mail · draft</span></div>
        <div class="space-y-1.5 p-2">
          <div class="h-2 w-1/3 rounded bg-line-strong"></div>
          <div class="typing h-2 rounded bg-accent-500/40"></div>
          <div class="h-2 w-4/5 rounded bg-line"></div>
          <div class="ml-auto mt-1 w-fit rounded border border-amber-300/50 bg-amber-300/10 px-1.5 py-0.5 font-mono text-[0.5rem] text-amber-200 approve">
            approve send?
          </div>
        </div>
      </div>

      <!-- Ghost cursors -->
      {
        workers.map((w) => (
          <div class:list={['ghost', w.cls]}>
            <svg viewBox="0 0 24 24" class="h-4 w-4 drop-shadow-[0_0_6px_rgb(62_240_138/0.9)] sm:h-5 sm:w-5">
              <path d="M4 2.5 19.5 12l-6.6 1.4L16.6 21l-2.9 1.3-3.7-7.6L4 19V2.5Z" fill="#3ef08a" stroke="#030504" stroke-width="1.2" />
            </svg>
            <span class="ml-3 rounded bg-accent-400 px-1 font-mono text-[0.5rem] font-semibold text-void sm:text-[0.55rem]">{w.label}</span>
          </div>
        ))
      }

      <!-- Your own cursor, idle in the corner -->
      <div class="absolute bottom-[8%] right-[7%] z-30 flex items-start opacity-80">
        <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5">
          <path d="M4 2.5 19.5 12l-6.6 1.4L16.6 21l-2.9 1.3-3.7-7.6L4 19V2.5Z" fill="#eaf2ed" stroke="#030504" stroke-width="1.2" />
        </svg>
        <span class="ml-1 rounded bg-ink px-1 font-mono text-[0.5rem] font-semibold text-void sm:text-[0.55rem]">you</span>
      </div>
    </div>

    <!-- Activity log -->
    <div class="relative z-10 border-t border-line bg-surface/90 px-4 py-2.5 font-mono text-[0.65rem] sm:text-[0.7rem]">
      <ul class="senju-log h-[3.6em] overflow-hidden leading-[1.8em]" aria-hidden="true" data-lines={JSON.stringify(log)}>
        {
          log.slice(0, 2).map(([who, msg]) => (
            <li class="truncate">
              <span class="text-accent-400">{who}</span> <span class="text-faint">›</span> <span class="text-ink-soft">{msg}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .win {
    position: absolute;
    z-index: 10;
    overflow: hidden;
    border-radius: 0.6rem;
    border: 1px solid var(--color-line-strong);
    background: color-mix(in oklab, var(--color-surface) 92%, transparent);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.9);
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 3px;
    border-bottom: 1px solid var(--color-line);
    padding: 4px 6px;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    color: var(--color-faint);
  }
  .win-bar i {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-line-strong);
  }
  .win-bar span {
    margin-left: 4px;
  }
  .flow {
    fill: none;
    stroke-width: 1.4;
    stroke-dasharray: 2 2;
    animation: flow 1.2s linear infinite;
    vector-effect: non-scaling-stroke;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -8;
    }
  }

  .ghost {
    position: absolute;
    z-index: 30;
    display: flex;
    align-items: flex-start;
    left: 0;
    top: 0;
    will-change: transform;
  }
  .ghost span {
    margin-top: 12px;
    margin-left: -2px;
  }
  .c1 {
    animation: g1 7s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  .c2 {
    animation: g2 8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  .c3 {
    animation: g3 9s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  /* Positions are percentages of the stage via left/top. */
  @keyframes g1 {
    0%,
    100% {
      left: 14%;
      top: 34%;
    }
    25% {
      left: 32%;
      top: 38%;
    }
    45% {
      left: 32%;
      top: 38%;
    }
    70% {
      left: 20%;
      top: 47%;
    }
  }
  @keyframes g2 {
    0%,
    100% {
      left: 64%;
      top: 32%;
    }
    30% {
      left: 76%;
      top: 40%;
    }
    55% {
      left: 70%;
      top: 44%;
    }
    80% {
      left: 86%;
      top: 36%;
    }
  }
  @keyframes g3 {
    0%,
    100% {
      left: 38%;
      top: 66%;
    }
    35% {
      left: 52%;
      top: 70%;
    }
    65% {
      left: 62%;
      top: 80%;
    }
    85% {
      left: 62%;
      top: 80%;
    }
  }
  .hl {
    animation: hl 7s ease-in-out infinite;
  }
  @keyframes hl {
    0%,
    30% {
      box-shadow: none;
    }
    40%,
    60% {
      box-shadow: 0 0 0 2px rgb(62 240 138 / 0.7);
    }
  }
  .cell-fill {
    animation: cell 8s ease-in-out infinite;
  }
  @keyframes cell {
    0%,
    45% {
      background: var(--color-raised);
    }
    55%,
    100% {
      background: rgb(62 240 138 / 0.55);
    }
  }
  .typing {
    animation: typing 9s steps(14) infinite;
  }
  @keyframes typing {
    0% {
      width: 0;
    }
    50%,
    100% {
      width: 90%;
    }
  }
  .approve {
    animation: approve 9s ease-in-out infinite;
  }
  @keyframes approve {
    0%,
    55% {
      opacity: 0;
    }
    65%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .senju-log :global(li) {
    animation: logIn 0.4s ease;
  }
  @keyframes logIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLUListElement>('.senju-log').forEach((ul) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lines: [string, string][] = JSON.parse(ul.dataset.lines ?? '[]');
    let i = 2;
    const render = (who: string, msg: string) => {
      const li = document.createElement('li');
      li.className = 'truncate';
      const a = document.createElement('span');
      a.className = who === 'you' ? 'text-ink' : 'text-accent-400';
      a.textContent = who;
      const sep = document.createElement('span');
      sep.className = 'text-faint';
      sep.textContent = ' › ';
      const b = document.createElement('span');
      b.className = 'text-ink-soft';
      b.textContent = msg;
      li.append(a, sep, b);
      return li;
    };
    setInterval(() => {
      if (document.hidden) return;
      const [who, msg] = lines[i % lines.length];
      ul.appendChild(render(who, msg));
      while (ul.children.length > 2) ul.removeChild(ul.firstElementChild!);
      i++;
    }, 1900);
  });
</script>
