---
// Animated diagram of Senju: a lead agent dispatching three workers, each with
// its own cursor, across app windows on one desktop. Drawn as a light technical
// figure (thin rules, mono labels, green only for the agents) to match the site.
const workers = [
  { label: 'w1', cls: 'c1' },
  { label: 'w2', cls: 'c2' },
  { label: 'w3', cls: 'c3' },
];
const log = [
  ['lead', 'split goal into 3 tasks, spawning workers'],
  ['w1', 'browser › searching flights SFO → JFK'],
  ['w2', 'sheets › filling row 14 with quotes'],
  ['w3', 'mail › drafting summary for the team'],
  ['lead', 'w1 found a cheaper fare, replanning'],
  ['w3', 'waiting for approval: send as you?'],
  ['you', 'approved'],
  ['lead', 'done · retrospective saved to skill.md'],
];
const arrow = 'M4 2.5 19.5 12l-6.6 1.4L16.6 21l-2.9 1.3-3.7-7.6L4 19V2.5Z';
---

<figure class="senju" aria-label="Animated diagram of Senju running three agents on one desktop" role="img">
  <div class="prompt">
    <span class="kanji">千手</span>
    <span class="sep">›</span>
    <span class="text">plan my NYC trip, log quotes in the sheet, and email the team<span class="caret"></span></span>
    <span class="keys">⌘⇧␣</span>
  </div>

  <div class="stage">
    <svg class="links" viewBox="0 0 160 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M80 14 L80 20 L26 20 L26 30" class="flow"></path>
      <path d="M80 14 L80 20 L134 20 L134 28" class="flow"></path>
      <path d="M80 14 L80 58" class="flow"></path>
    </svg>

    <div class="lead"><span class="dot"></span>lead</div>

    <div class="win w-flights">
      <div class="bar"><span>01</span>flights</div>
      <div class="body">
        <div class="ln" style="width: 72%"></div>
        <div class="fields">
          <div class="field"></div>
          <div class="field hl"></div>
        </div>
        <div class="ln" style="width: 48%"></div>
        <div class="ln" style="width: 62%"></div>
      </div>
    </div>

    <div class="win w-sheet">
      <div class="bar"><span>02</span>quotes.xlsx</div>
      <div class="sheet">
        {Array.from({ length: 16 }).map((_, i) => <div class:list={['cell', i === 9 && 'fill']} />)}
      </div>
    </div>

    <div class="win w-mail">
      <div class="bar"><span>03</span>mail · draft</div>
      <div class="body">
        <div class="ln" style="width: 34%"></div>
        <div class="ln typing"></div>
        <div class="ln" style="width: 80%"></div>
        <div class="approve">approve send? [y/n]</div>
      </div>
    </div>

    {
      workers.map((w) => (
        <div class:list={['ghost', w.cls]}>
          <svg viewBox="0 0 24 24">
            <path d={arrow} class="agent" />
          </svg>
          <span class="tag">{w.label}</span>
        </div>
      ))
    }

    <div class="ghost you">
      <svg viewBox="0 0 24 24"><path d={arrow} class="human" /></svg>
      <span class="tag tag-you">you</span>
    </div>
  </div>

  <div class="log">
    <ul class="senju-log" aria-hidden="true" data-lines={JSON.stringify(log)}>
      {
        log.slice(0, 2).map(([who, msg]) => (
          <li>
            <span class:list={['who', who === 'you' && 'is-you']}>{who}</span> <span class="msg">{msg}</span>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .senju {
    --ink: var(--color-ink);
    --rule: var(--color-line-strong);
    --soft: var(--color-line);
    --agent: var(--color-accent-500);
    position: relative;
    margin: 0;
    border: 1px solid var(--ink);
    background:
      radial-gradient(circle, var(--color-line-strong) 0.8px, transparent 1px) 0 0 / 14px 14px,
      var(--color-bg);
    font-family: var(--font-mono);
    color: var(--ink);
    overflow: hidden;
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--ink);
    background: var(--color-bg);
    font-size: 13px;
    white-space: nowrap;
  }
  .kanji {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-accent-600);
  }
  .sep {
    color: var(--color-muted);
  }
  .text {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 13px;
    margin-left: 2px;
    vertical-align: -2px;
    background: var(--ink);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .keys {
    margin-left: auto;
    padding: 0 5px;
    border: 1px solid var(--rule);
    font-size: 10px;
    color: var(--color-muted);
  }
  @media (max-width: 560px) {
    .keys {
      display: none;
    }
  }

  .stage {
    position: relative;
    aspect-ratio: 16 / 9.5;
  }
  .links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .flow {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
    animation: flow 1.4s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -12;
    }
  }

  .lead {
    position: absolute;
    left: 50%;
    top: 6%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--color-bg);
    font-size: 12px;
    z-index: 2;
  }
  .dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent-400);
    animation: blink 1.6s steps(1) infinite;
  }

  .win {
    position: absolute;
    z-index: 1;
    width: 40%;
    border: 1px solid var(--ink);
    background: var(--color-bg);
  }
  .w-flights {
    left: 4%;
    top: 30%;
  }
  .w-sheet {
    right: 4%;
    top: 28%;
  }
  .w-mail {
    left: 30%;
    top: 61%;
  }
  .bar {
    display: flex;
    gap: 8px;
    padding: 3px 7px;
    border-bottom: 1px solid var(--ink);
    font-size: 11px;
  }
  .bar span {
    color: var(--color-muted);
  }
  .body {
    display: grid;
    gap: 6px;
    padding: 8px;
  }
  .ln {
    height: 5px;
    background: var(--soft);
  }
  .fields {
    display: flex;
    gap: 6px;
  }
  .field {
    flex: 1;
    height: 20px;
    border: 1px solid var(--rule);
  }
  .field.hl {
    animation: hl 7s ease-in-out infinite;
  }
  @keyframes hl {
    0%,
    30%,
    70%,
    100% {
      border-color: var(--rule);
      background: transparent;
    }
    40%,
    60% {
      border-color: var(--agent);
      background: color-mix(in oklab, var(--agent) 14%, transparent);
    }
  }
  .sheet {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--soft);
  }
  .cell {
    height: 12px;
    background: var(--color-bg);
  }
  .cell.fill {
    animation: fill 8s ease-in-out infinite;
  }
  @keyframes fill {
    0%,
    45% {
      background: var(--color-bg);
    }
    55%,
    100% {
      background: var(--agent);
    }
  }
  .typing {
    background: var(--agent);
    opacity: 0.6;
    animation: typing 9s steps(14) infinite;
  }
  @keyframes typing {
    0% {
      width: 0;
    }
    50%,
    100% {
      width: 88%;
    }
  }
  .approve {
    justify-self: end;
    padding: 1px 6px;
    border: 1px solid var(--ink);
    font-size: 10px;
    animation: approve 9s ease-in-out infinite;
  }
  @keyframes approve {
    0%,
    55%,
    100% {
      opacity: 0;
    }
    65%,
    90% {
      opacity: 1;
    }
  }

  .ghost {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    left: 0;
    top: 0;
  }
  .ghost svg {
    width: 18px;
    height: 18px;
  }
  .agent {
    fill: var(--agent);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .human {
    fill: var(--color-bg);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .tag {
    margin: 13px 0 0 -3px;
    padding: 0 4px;
    background: var(--agent);
    color: var(--ink);
    font-size: 11px;
    line-height: 16px;
  }
  .tag-you {
    background: var(--ink);
    color: var(--color-bg);
  }
  .you {
    left: auto;
    top: auto;
    right: 6%;
    bottom: 7%;
  }
  .c1 {
    animation: g1 7s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  .c2 {
    animation: g2 8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  .c3 {
    animation: g3 9s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  @keyframes g1 {
    0%,
    100% {
      left: 14%;
      top: 40%;
    }
    25%,
    45% {
      left: 33%;
      top: 44%;
    }
    70% {
      left: 20%;
      top: 52%;
    }
  }
  @keyframes g2 {
    0%,
    100% {
      left: 64%;
      top: 36%;
    }
    30% {
      left: 76%;
      top: 42%;
    }
    55% {
      left: 70%;
      top: 45%;
    }
    80% {
      left: 86%;
      top: 38%;
    }
  }
  @keyframes g3 {
    0%,
    100% {
      left: 38%;
      top: 70%;
    }
    35% {
      left: 52%;
      top: 74%;
    }
    65%,
    85% {
      left: 62%;
      top: 84%;
    }
  }

  .log {
    border-top: 1px solid var(--ink);
    background: var(--color-bg);
    padding: 8px 14px;
    font-size: 12.5px;
  }
  .senju-log {
    height: 3.6em;
    overflow: hidden;
    line-height: 1.8em;
  }
  .senju-log :global(li) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    animation: logIn 0.4s ease;
  }
  .senju-log :global(.who) {
    display: inline-block;
    min-width: 4ch;
    color: var(--color-accent-600);
  }
  .senju-log :global(.who.is-you) {
    color: var(--ink);
  }
  .senju-log :global(.msg) {
    color: var(--color-ink-soft);
  }
  @keyframes logIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLUListElement>('.senju-log').forEach((ul) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lines: [string, string][] = JSON.parse(ul.dataset.lines ?? '[]');
    let i = 2;
    setInterval(() => {
      if (document.hidden) return;
      const [who, msg] = lines[i % lines.length];
      const li = document.createElement('li');
      const a = document.createElement('span');
      a.className = who === 'you' ? 'who is-you' : 'who';
      a.textContent = who;
      const b = document.createElement('span');
      b.className = 'msg';
      b.textContent = msg;
      li.append(a, ' ', b);
      ul.appendChild(li);
      while (ul.children.length > 2) ul.removeChild(ul.firstElementChild!);
      i++;
    }, 1900);
  });
</script>
