---
// Theorem/proof block for math project pages (used in MDX).
interface Props {
  label?: string;
  kind?: 'theorem' | 'proof';
}
const { label = 'Theorem', kind = 'theorem' } = Astro.props;
---

<div class:list={['my-8 border-l py-1 pl-5', kind === 'proof' ? 'border-line-strong' : 'border-ink']}>
  <p class:list={['mono mb-2', kind === 'proof' ? 'dim' : 'accent']}>{label}</p>
  <div class:list={['[&_p]:my-0', kind === 'proof' ? 'text-ink-soft' : 'italic text-ink']}>
    <slot />
  </div>
</div>
