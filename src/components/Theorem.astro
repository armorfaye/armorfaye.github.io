---
// Theorem/proof block for math project pages (used in MDX).
interface Props {
  label?: string;
  kind?: 'theorem' | 'proof';
}
const { label = 'Theorem', kind = 'theorem' } = Astro.props;
---

<div class="my-8 rounded-xl border border-line bg-surface px-5 py-4">
  <p class:list={['mb-1.5 text-sm font-semibold', kind === 'proof' ? 'text-muted' : 'text-accent-400']}>
    {label}
  </p>
  <div class:list={['[&_p]:my-0', kind === 'proof' ? 'text-ink-soft' : 'italic text-ink']}>
    <slot />
  </div>
</div>
