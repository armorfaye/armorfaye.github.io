---
import { navLinks, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="mono flex items-baseline justify-between gap-4 border-b border-line py-[18px]">
  <a href="/" class="tlink" data-scramble>{site.shortName}</a>
  <nav aria-label="Main">
    <ul class="flex gap-4 sm:gap-[22px]">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="tlink" aria-current={isActive(link.href) ? 'page' : undefined} data-scramble>
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a href={site.resume} class="tlink" data-scramble>CV</a></li>
    </ul>
  </nav>
</header>
