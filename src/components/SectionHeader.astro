---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  link?: { label: string; href: string };
  as?: 'h1' | 'h2';
}
const { eyebrow, title, subtitle, link, as: Tag = 'h2' } = Astro.props;
---

<div class="reveal mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <Tag
      class:list={[
        'font-semibold text-ink',
        Tag === 'h1' ? 'text-4xl leading-[1.05] sm:text-5xl' : 'text-2xl sm:text-[2rem] sm:leading-tight',
      ]}
    >
      {title}
    </Tag>
    {subtitle && <p class="mt-3 text-[1.05rem] leading-relaxed text-muted">{subtitle}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="group shrink-0 text-[0.92rem] text-muted transition-colors hover:text-ink">
        {link.label} <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    )
  }
</div>
