---
interface Props {
  slug: string;
  title: string;
  summary: string;
  dates: string;
  thumbnail?: string;
  award?: string;
  size?: 'default' | 'wide';
}
const { slug, title, summary, dates, thumbnail, award, size = 'default' } = Astro.props;
const href = `/projects/${slug}`;
const year = dates.match(/\d{4}(?!.*\d{4})/)?.[0] ?? dates;
---

<a
  href={href}
  class:list={['group block', size === 'wide' && 'md:grid md:grid-cols-[1.15fr_1fr] md:items-center md:gap-10']}
>
  <div class="overflow-hidden rounded-xl border border-line bg-void transition-colors duration-200 group-hover:border-line-strong">
    {
      thumbnail && (
        <img
          src={thumbnail}
          alt=""
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />
      )
    }
  </div>

  <div class:list={['mt-5', size === 'wide' && 'md:mt-0']}>
    <p class="text-sm text-faint">
      {year}
      {award && <span class="text-accent-400"> · {award}</span>}
    </p>
    <h3
      class:list={[
        'mt-1.5 font-semibold leading-snug text-ink transition-colors group-hover:text-accent-300',
        size === 'wide' ? 'text-2xl sm:text-[1.75rem]' : 'text-xl',
      ]}
    >
      {title}
    </h3>
    <p class:list={['mt-2.5 leading-relaxed text-muted', size === 'wide' ? 'text-[1.02rem]' : 'line-clamp-3 text-[0.97rem]']}>
      {summary}
    </p>
  </div>
</a>
