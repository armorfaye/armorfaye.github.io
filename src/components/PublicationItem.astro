---
import { selfNames, type Publication } from '../data/publications';

interface Props {
  pub: Publication;
  // Compact rows (home page) skip the blurb and use the short venue.
  compact?: boolean;
}
const { pub, compact = false } = Astro.props;
const primary = pub.project ? `/projects/${pub.project}` : pub.links[0]?.url;
const external = primary?.startsWith('http');
---

<li class="pub rv" data-area={pub.area}>
  <a
    href={primary}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class="pub-title"
  >
    {pub.title}
  </a>
  <p class="pub-authors">
    {
      pub.authors.map((a, i) => (
        <>
          <span class:list={[selfNames.includes(a) && 'me']}>{a}</span>
          {i < pub.authors.length - 1 && ', '}
        </>
      ))
    }
  </p>
  {!compact && <p class="pub-blurb">{pub.blurb}</p>}
  <p class="mono link-row">
    <span class="dim">{compact ? pub.venueShort : pub.venue} · {pub.year}</span>
    {
      pub.links.map((l) => (
        <a href={l.url} class="tag-link" {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          {l.label}
        </a>
      ))
    }
  </p>
</li>

<style>
  .pub {
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .pub-title {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color 0.2s;
  }
  .pub-title:hover {
    color: var(--accent);
  }
  .pub-authors {
    margin-top: 4px;
    font-size: 16px;
    color: var(--color-muted);
  }
  .pub-authors .me {
    color: var(--color-ink);
  }
  .pub-blurb {
    margin-top: 8px;
    max-width: 70ch;
  }
</style>
