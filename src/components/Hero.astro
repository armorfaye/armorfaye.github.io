---
import { site, socialLinks } from '../data/site';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<section class="container-x grid items-center gap-12 pb-12 pt-10 sm:pt-16 md:grid-cols-[1.35fr_1fr] md:gap-10 lg:pb-20 lg:pt-20">
  <div class="relative z-10 order-2 md:order-1">
    <h1 class="reveal text-5xl font-semibold leading-[1] tracking-[-0.035em] text-ink sm:text-7xl">
      Jerry Liu
    </h1>
    <p class="reveal mt-4 text-lg text-muted sm:text-xl" style="--delay: 60ms">
      Mathematics at Stanford
    </p>

    <div class="reveal mt-8 max-w-xl space-y-4 text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg" style="--delay: 120ms">
      <p>
        I do LLM research in Percy Liang’s group at Stanford NLP, working on{' '}
        <a href="https://marin.community" class="link" {...ext}>Marin</a>, and at{' '}
        <a href="https://hazyresearch.stanford.edu" class="link" {...ext}>Hazy Research</a> on
        speculative decoding.
      </p>
      <p>
        Before that I pretrained models at StepFun, built pose transformers at MIT, and worked on
        configuration spaces with Charles Fefferman at Princeton.
      </p>
    </div>

    <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--delay: 180ms">
      <a href="/research" class="btn-primary">Research</a>
      <a href="/projects" class="btn-secondary">Projects</a>
    </div>

    <ul class="reveal mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[0.92rem]" style="--delay: 220ms">
      {
        socialLinks.map((l) => (
          <li>
            <a
              href={l.url}
              target={l.url.startsWith('http') ? '_blank' : undefined}
              rel={l.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="text-muted transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="reveal order-1 w-full max-w-[11rem] sm:max-w-[14rem] md:order-2 md:ml-auto md:max-w-[20rem]" style="--delay: 100ms">
    <img
      src={site.profile}
      alt="Portrait of Jiayu (Jerry) Liu"
      width="600"
      height="600"
      class="aspect-[4/5] w-full rounded-2xl border border-line object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
