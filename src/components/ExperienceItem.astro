---
import type { ExperienceEntry } from '../data/experience';

interface Props {
  entry: ExperienceEntry;
}
const { entry } = Astro.props;
const links = entry.links ?? [];
---

<li class="rv">
  <span class="mono dim">{entry.dates}</span>
  <span class="t-main">{entry.org}</span>
  <span class="t-sub">{entry.role}</span>
  {
    (entry.bullets.length > 0 || links.length > 0) && (
      <div class="t-more">
        {entry.bullets.length > 0 && (
          <ul class="dash-list">
            {entry.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        )}
        {links.length > 0 && (
          <p class="mono link-row">
            {links.map((l) => (
              <a href={l.url} class="tag-link" {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                {l.label}
              </a>
            ))}
          </p>
        )}
      </div>
    )
  }
</li>
